{
  "name": "invicto-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --manifest && vite build --ssr src/main.tsx --outDir .ssr && node scripts/prerender.mjs && node scripts/verify-seo.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "verify:production": "node scripts/verify-production.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "audit:desktop": "lighthouse http://127.0.0.1:4173/products/traceq --chrome-flags=--headless --preset=desktop --output=html --output=json --output-path=./lighthouse-desktop",
    "audit:mobile": "lighthouse http://127.0.0.1:4173/products/traceq --chrome-flags=--headless --output=html --output=json --output-path=./lighthouse-mobile",
    "test:e2e": "node tests/run.mjs e2e",
    "test:responsive": "node tests/run.mjs responsive",
    "test:menu": "node tests/run.mjs menu",
    "test:a11y": "node tests/run.mjs a11y",
    "test:perf": "node tests/run.mjs perf",
    "test:seo": "node tests/run.mjs seo",
    "test:security": "node tests/run.mjs security",
    "test:links": "node tests/run.mjs links",
    "test:html": "node tests/run.mjs html",
    "test:css": "node tests/run.mjs css",
    "test:spell": "node tests/run.mjs spell",
    "test:placeholders": "node tests/run.mjs placeholders",
    "test:all": "node tests/run.mjs all",
    "test:functional": "node tests/run.mjs functional",
    "test:robustness": "node tests/run.mjs robustness",
    "test:quality": "node tests/run.mjs quality",
    "test:checks": "node tests/run.mjs checks",
    "test:install": "node tests/install-browsers.mjs",
    "test:live": "node tests/run.mjs live",
    "test:content": "node tests/run.mjs content",
    "test:maintenance": "node tests/run.mjs maintenance",
    "test:hash": "node tests/run.mjs hash",
    "test:form-fallback": "node tests/run.mjs nojs-form",
    "test:keyboard": "node tests/run.mjs keyboard",
    "test:input-stress": "node tests/run.mjs input-stress",
    "test:menu:regression": "playwright test --config tests/playwright.config.ts",
    "test:nav:regression": "playwright test --config tests/playwright.nav.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cspell": "^10.4.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "html-validate": "^11.18.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "purgecss": "^8.0.0",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.5"
  }
}
